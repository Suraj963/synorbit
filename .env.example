# Permanent production URL, used for canonical links, sitemap, robots and Open Graph.
# Defaults to https://synorbit.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://synorbit.vercel.app

# Enquiry form delivery via Resend (https://resend.com). Server-side only.
# Without these, the form validates but replies "not configured" and offers an email fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=synorbit.solutions@gmail.com
# Must be a sender on a domain verified in Resend. The default onboarding@resend.dev
# sender can only deliver to the Resend account owner's own address.
CONTACT_FROM_EMAIL="Synorbit Website <onboarding@resend.dev>"
